/*
 * -------------------------------------------------
 *  Nextflow process config file
 * -------------------------------------------------
 * Define here the different level of RAM/CPUs use
 * for the different processes as well as the track
 * reports
 */

params {
  // Limit max resources
  maxCpus = 40
  maxMemory = 180.GB
  maxTime = 240.h

  // Define specific cluster options to use GPU queue
  // These options will vary from one HPC infrastruture to another  
  executor {
    gpu {
      slurm = "--nodes=1 --partition=dev_gpu --account=dev_gpu --gres=gpu:1"
      local = ""
    }
  }

  // Define the binding options depending on the profile (i.e. container)
  binding {
    apptainer = "-B"
    docker = "-v"
    podman = "-v"
    singularity = "-B"
  }
}

process {
  // Defaults for processes without labels


  //errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
  errorStrategy = 'retry'
  maxRetries = 1
  maxErrors = '-1'

  // Process-specific resource requirements
  // Customise requirements for specific processes
  withLabel: minCpu {
    cpus = {
      def obj = 1 * task.attempt
      try {
        return Math.min(obj, params.maxCpus as Integer)
      }
      catch (Exception all) {
        System.err.println("   ### ERROR ###   Max cpus '${params.maxCpus}' is not valid! Using default value: ${obj}")
        return obj
      }
    }
  }
  withLabel: lowCpu {
    cpus = {
      def obj = 2 * task.attempt
      try {
        return Math.min(obj, params.maxCpus as Integer)
      }
      catch (Exception all) {
        System.err.println("   ### ERROR ###   Max cpus '${params.maxCpus}' is not valid! Using default value: ${obj}")
        return obj
      }
    }
  }
  withLabel: medCpu {
    cpus = {
      def obj = 4 * task.attempt
      try {
        return Math.min(obj, params.maxCpus as Integer)
      }
      catch (Exception all) {
        System.err.println("   ### ERROR ###   Max cpus '${params.maxCpus}' is not valid! Using default value: ${obj}")
        return obj
      }
    }
  }
  withLabel: highCpu {
    cpus = {
      def obj = 8 * task.attempt
      try {
        return Math.min(obj, params.maxCpus as Integer)
      }
      catch (Exception all) {
        System.err.println("   ### ERROR ###   Max cpus '${params.maxCpus}' is not valid! Using default value: ${obj}")
        return obj
      }
    }
  }
  withLabel: extraCpu {
    cpus = {
      def obj = 16 * task.attempt
      try {
        return Math.min(obj, params.maxCpus as Integer)
      }
      catch (Exception all) {
        System.err.println("   ### ERROR ###   Max cpus '${params.maxCpus}' is not valid! Using default value: ${obj}")
        return obj
      }
    }
  }


  withLabel: minMem {
    memory = {
      def obj = 4.GB * task.attempt
      try {
        return obj.compareTo(params.maxMemory) == 1 ? params.maxMemory as nextflow.util.MemoryUnit : obj
      }
      catch (Exception all) {
        System.err.println("   ### ERROR ###   Max memory '${params.maxMemory}' is not valid! Using default value: ${obj}")
        return obj
      }
    }
  }
  withLabel: lowMem {
    memory = {
      def obj = 8.GB * task.attempt
      try {
        return obj.compareTo(params.maxMemory) == 1 ? params.maxMemory as nextflow.util.MemoryUnit : obj
      }
      catch (Exception all) {
        System.err.println("   ### ERROR ###   Max memory '${params.maxMemory}' is not valid! Using default value: ${obj}")
        return obj
      }
    }
  }
  withLabel: medMem {
    memory = {
      def obj = 16.GB * task.attempt
      try {
        return obj.compareTo(params.maxMemory) == 1 ? params.maxMemory as nextflow.util.MemoryUnit : obj
      }
      catch (Exception all) {
        System.err.println("   ### ERROR ###   Max memory '${params.maxMemory}' is not valid! Using default value: ${obj}")
        return obj
      }
    }
  }
  withLabel: highMem {
    memory = {
      def obj = 32.GB * task.attempt
      try {
        return obj.compareTo(params.maxMemory) == 1 ? params.maxMemory as nextflow.util.MemoryUnit : obj
      }
      catch (Exception all) {
        System.err.println("   ### ERROR ###   Max memory '${params.maxMemory}' is not valid! Using default value: ${obj}")
        return obj
      }
    }
  }
  withLabel: extraMem {
    memory = {
      def obj = 80.GB * task.attempt
      try {
        return obj.compareTo(params.maxMemory) == 1 ? params.maxMemory as nextflow.util.MemoryUnit : obj
      }
      catch (Exception all) {
        System.err.println("   ### ERROR ###   Max memory '${params.maxMemory}' is not valid! Using default value: ${obj}")
        return obj
      }
    }
  }
  withLabel: supraMem {
    memory = {
      def obj = 128.GB * task.attempt
      try {
        return obj.compareTo(params.maxMemory) == 1 ? params.maxMemory as nextflow.util.MemoryUnit : obj
      }
      catch (Exception all) {
        System.err.println("   ### ERROR ###   Max memory '${params.maxMemory}' is not valid! Using default value: ${obj}")
        return obj
      }
    }
  }
}

// Capture exit codes from upstream processes when piping
process.shell = ['/bin/bash', '-euo', 'pipefail']

// From nf-core
timeline {
  enabled = true
  overwrite = true
  file = "${params.summaryDir}/trace/timeline.html"
}
report {
  enabled = true
  overwrite = true
  file = "${params.summaryDir}/trace/report.html"
}
trace {
  enabled = true
  raw = true
  overwrite = true
  fields = 'process,task_id,hash,native_id,module,container,tag,name,status,exit,submit,start,complete,duration,realtime,%cpu,%mem,rss,vmem,peak_rss,peak_vmem,rchar,wchar,syscr,syscw,read_bytes,write_bytes,attempt,workdir,scratch,queue,cpus,memory,disk,time,env'
  file = "${params.summaryDir}/trace/trace.txt"
}
dag {
  enabled = true
  overwrite = true
  file = "${params.summaryDir}/trace/DAG.pdf"
}
